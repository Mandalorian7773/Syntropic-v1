# Copy to .env and edit. .env is gitignored; this file is the documentation.
#
# The ONLY difference between a dev laptop and the demo host is this file.
# If you find yourself changing code to switch environments, that is a bug.

# --- Single-machine defaults (demo host, and solo dev) -----------------------
MODEL_ENDPOINT=http://localhost:8080
RAG_ENDPOINT=http://localhost:8001
QDRANT_URL=http://localhost:6333
WORKSPACE_DIR=./workspace
ARTIFACTS_DIR=./artifacts
MODELS_DIR=./models
DB_PATH=./data/workbench.db
MAX_STEPS=10

# --- Three-laptop LAN development -------------------------------------------
# During the build week the three services live on three different machines.
# Comment out the localhost block above and use these instead, substituting
# your teammates' LAN addresses. Everything below is a private RFC1918 address;
# none of it survives to the demo host.
#
#   Person 3 (backend + llama-server)  192.168.1.10
#   Person 2 (ragsvc + qdrant)         192.168.1.11
#   Person 1 (frontend)                192.168.1.12
#
# MODEL_ENDPOINT=http://192.168.1.10:8080
# RAG_ENDPOINT=http://192.168.1.11:8001
# QDRANT_URL=http://192.168.1.11:6333
#
# The frontend dev server proxies /api to whatever this points at:
# VITE_API_TARGET=http://192.168.1.10:8000
#
# Use docker-compose.dev.yml for this, not docker-compose.yml -- the demo
# compose file puts everything on an internal network with no external route,
# which is exactly what you do NOT want across three laptops.
