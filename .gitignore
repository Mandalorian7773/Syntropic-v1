# Weights: gigabytes, fetched by scripts/download-models.sh, never committed.
models/*.gguf
models/*.onnx
models/*.bin
models/*.safetensors
# The four patterns above only match files sitting directly in models/.
# scripts/fetch-rag-models.py puts each model in its own subdirectory, so
# without these two lines a 542 MB ONNX graph slips past the ignore and into a
# commit that GitHub then refuses -- its hard limit is 100 MB per file.
models/**/*.onnx
models/**/*.gguf
models/**/tokenizer.json

# Runtime state
workspace/
artifacts/
qdrant_data/
data/
offline-bundle/

# Secrets and local config
.env

# Python
__pycache__/
*.py[cod]
.venv/
# ragsvc runs on 3.11: rapidocr-onnxruntime caps at Python <3.13 and the
# root .venv is 3.13. Second venv, same reason it must never be committed.
.venv311/
*.egg-info/
.pytest_cache/
build/

# Node
node_modules/
dist/
.vite/

# OS
.DS_Store

# NOTE: bench/results/ is deliberately NOT ignored. Those files are committed
# evidence that the system got faster. Do not add them here.

# Dev server logs from `make dev-*` / uvicorn redirects.
*.log

# Downloaded datasets (kagglehub etc.). The demo uses the small sample copied
# into demo/datasets/ by scripts/fetch-pid-symbols.py; the raw download stays out.
demo/datasets/**/raw/
